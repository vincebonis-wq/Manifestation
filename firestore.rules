rules_version = '2';
// Règles Firestore — Manifestation + Émotion (même projet Firebase).
// Firebase Console → Firestore Database → Règles → Publier.
// Chaque utilisateur ne lit/écrit QUE ses propres données
// (document users/{uid} de Manifestation + sous-collections d'Émotion).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
